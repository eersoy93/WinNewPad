/*
 * WinNewPad - An old WordPad-like word processor written with C and Windows API.
 * WinNewPad.rc - Resource script.
 */

#include <windows.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/* Application manifest (Common Controls v6, DPI awareness) */
1 RT_MANIFEST "WinNewPad.manifest"

/* Main menu */
IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                IDM_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            IDM_FILE_OPEN
        MENUITEM "&Save\tCtrl+S",               IDM_FILE_SAVE
        MENUITEM "Save &As...",                 IDM_FILE_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "&Print...\tCtrl+P",           IDM_FILE_PRINT
        MENUITEM "Page Set&up...",              IDM_FILE_PAGESETUP
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_FILE_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               IDM_EDIT_UNDO
        MENUITEM "&Redo\tCtrl+Y",               IDM_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                IDM_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",               IDM_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              IDM_EDIT_PASTE
        MENUITEM "Cle&ar\tDel",                 IDM_EDIT_DELETE
        MENUITEM "Select A&ll\tCtrl+A",         IDM_EDIT_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "&Find...\tCtrl+F",            IDM_EDIT_FIND
        MENUITEM "Find &Next\tF3",              IDM_EDIT_FINDNEXT
        MENUITEM "R&eplace...\tCtrl+H",         IDM_EDIT_REPLACE
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    IDM_VIEW_TOOLBAR
        MENUITEM "&Format Bar",                 IDM_VIEW_FORMATBAR
        MENUITEM "&Status Bar",                 IDM_VIEW_STATUSBAR
        MENUITEM SEPARATOR
        MENUITEM "&Word Wrap",                  IDM_VIEW_WORDWRAP
    END
    POPUP "&Insert"
    BEGIN
        MENUITEM "&Date and Time...",           IDM_INSERT_DATETIME
    END
    POPUP "F&ormat"
    BEGIN
        MENUITEM "&Font...",                    IDM_FORMAT_FONT
        MENUITEM "&Bold\tCtrl+B",               IDM_FORMAT_BOLD
        MENUITEM "&Italic\tCtrl+I",             IDM_FORMAT_ITALIC
        MENUITEM "&Underline\tCtrl+U",          IDM_FORMAT_UNDERLINE
        MENUITEM "Text &Color...",              IDM_FORMAT_COLOR
        MENUITEM SEPARATOR
        MENUITEM "Bullet &Style",               IDM_FORMAT_BULLET
        MENUITEM "&Paragraph...",               IDM_FORMAT_PARAGRAPH
        MENUITEM SEPARATOR
        MENUITEM "Align &Left\tCtrl+L",         IDM_FORMAT_ALIGNLEFT
        MENUITEM "Align C&enter\tCtrl+E",       IDM_FORMAT_ALIGNCENTER
        MENUITEM "Align &Right\tCtrl+R",        IDM_FORMAT_ALIGNRIGHT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About WinNewPad\tF1",        IDM_HELP_ABOUT
    END
END

/* Editor context menu */
IDR_CONTEXTMENU MENU
BEGIN
    POPUP "Context"
    BEGIN
        MENUITEM "Cu&t",                        IDM_EDIT_CUT
        MENUITEM "&Copy",                       IDM_EDIT_COPY
        MENUITEM "&Paste",                      IDM_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "&Font...",                    IDM_FORMAT_FONT
        MENUITEM "Bullet &Style",               IDM_FORMAT_BULLET
        MENUITEM "P&aragraph...",               IDM_FORMAT_PARAGRAPH
    END
END

/* Keyboard accelerators */
IDR_ACCEL ACCELERATORS
BEGIN
    "N",        IDM_FILE_NEW,           VIRTKEY, CONTROL
    "O",        IDM_FILE_OPEN,          VIRTKEY, CONTROL
    "S",        IDM_FILE_SAVE,          VIRTKEY, CONTROL
    "P",        IDM_FILE_PRINT,         VIRTKEY, CONTROL
    "Z",        IDM_EDIT_UNDO,          VIRTKEY, CONTROL
    "Y",        IDM_EDIT_REDO,          VIRTKEY, CONTROL
    "X",        IDM_EDIT_CUT,           VIRTKEY, CONTROL
    "C",        IDM_EDIT_COPY,          VIRTKEY, CONTROL
    "V",        IDM_EDIT_PASTE,         VIRTKEY, CONTROL
    "A",        IDM_EDIT_SELECTALL,     VIRTKEY, CONTROL
    "F",        IDM_EDIT_FIND,          VIRTKEY, CONTROL
    VK_F3,      IDM_EDIT_FINDNEXT,      VIRTKEY
    "H",        IDM_EDIT_REPLACE,       VIRTKEY, CONTROL
    "B",        IDM_FORMAT_BOLD,        VIRTKEY, CONTROL
    "I",        IDM_FORMAT_ITALIC,      VIRTKEY, CONTROL
    "U",        IDM_FORMAT_UNDERLINE,   VIRTKEY, CONTROL
    "L",        IDM_FORMAT_ALIGNLEFT,   VIRTKEY, CONTROL
    "E",        IDM_FORMAT_ALIGNCENTER, VIRTKEY, CONTROL
    "R",        IDM_FORMAT_ALIGNRIGHT,  VIRTKEY, CONTROL
    VK_F1,      IDM_HELP_ABOUT,         VIRTKEY
END

/* Date and Time dialog */
IDD_DATETIME DIALOGEX 0, 0, 180, 150
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Date and Time"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "&Available formats:", -1, 7, 7, 120, 8
    LISTBOX         IDC_DATETIME_LIST, 7, 18, 115, 125, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 128, 18, 45, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 128, 36, 45, 14
END

/* Paragraph dialog */
IDD_PARAGRAPH DIALOGEX 0, 0, 200, 110
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Paragraph"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Indentation (inches)", -1, 7, 7, 130, 62
    LTEXT           "&Left:", -1, 14, 21, 50, 8
    EDITTEXT        IDC_PARA_LEFT, 70, 19, 60, 12, ES_AUTOHSCROLL
    LTEXT           "&Right:", -1, 14, 36, 50, 8
    EDITTEXT        IDC_PARA_RIGHT, 70, 34, 60, 12, ES_AUTOHSCROLL
    LTEXT           "&First line:", -1, 14, 51, 50, 8
    EDITTEXT        IDC_PARA_FIRST, 70, 49, 60, 12, ES_AUTOHSCROLL
    LTEXT           "&Alignment:", -1, 7, 78, 50, 8
    COMBOBOX        IDC_PARA_ALIGN, 70, 76, 67, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 145, 7, 48, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 145, 25, 48, 14
END

/* Strings: "status bar help\ntooltip" */
STRINGTABLE
BEGIN
    IDS_APPNAME             "WinNewPad"
    IDS_UNTITLED            "Document"
    IDS_READY               "For Help, press F1"

    IDM_FILE_NEW            "Creates a new document.\nNew"
    IDM_FILE_OPEN           "Opens an existing document.\nOpen"
    IDM_FILE_SAVE           "Saves the active document.\nSave"
    IDM_FILE_SAVEAS         "Saves the active document with a new name.\nSave As"
    IDM_FILE_PRINT          "Prints the active document.\nPrint"
    IDM_FILE_PAGESETUP      "Changes the page layout settings.\nPage Setup"
    IDM_FILE_EXIT           "Quits WinNewPad.\nExit"

    IDM_EDIT_UNDO           "Undoes the last action.\nUndo"
    IDM_EDIT_REDO           "Redoes the previously undone action.\nRedo"
    IDM_EDIT_CUT            "Cuts the selection and puts it on the Clipboard.\nCut"
    IDM_EDIT_COPY           "Copies the selection and puts it on the Clipboard.\nCopy"
    IDM_EDIT_PASTE          "Inserts Clipboard contents.\nPaste"
    IDM_EDIT_DELETE         "Erases the selection.\nClear"
    IDM_EDIT_SELECTALL      "Selects the entire document.\nSelect All"
    IDM_EDIT_FIND           "Finds the specified text.\nFind"
    IDM_EDIT_FINDNEXT       "Repeats the last find.\nFind Next"
    IDM_EDIT_REPLACE        "Replaces specific text with different text.\nReplace"

    IDM_VIEW_TOOLBAR        "Shows or hides the toolbar.\nToggle Toolbar"
    IDM_VIEW_FORMATBAR      "Shows or hides the format bar.\nToggle Format Bar"
    IDM_VIEW_STATUSBAR      "Shows or hides the status bar.\nToggle Status Bar"
    IDM_VIEW_WORDWRAP       "Wraps text to the window.\nWord Wrap"

    IDM_INSERT_DATETIME     "Inserts the current date and/or time.\nDate/Time"

    IDM_FORMAT_FONT         "Changes the font of the selection.\nFont"
    IDM_FORMAT_BOLD         "Makes the selection bold (toggle).\nBold"
    IDM_FORMAT_ITALIC       "Makes the selection italic (toggle).\nItalic"
    IDM_FORMAT_UNDERLINE    "Underlines the selection (toggle).\nUnderline"
    IDM_FORMAT_COLOR        "Changes the color of the selection.\nColor"
    IDM_FORMAT_BULLET       "Inserts a bullet on this line.\nBullets"
    IDM_FORMAT_PARAGRAPH    "Changes the indents and alignment of the paragraph.\nParagraph"
    IDM_FORMAT_ALIGNLEFT    "Aligns text to the left.\nAlign Left"
    IDM_FORMAT_ALIGNCENTER  "Centers text.\nCenter"
    IDM_FORMAT_ALIGNRIGHT   "Aligns text to the right.\nAlign Right"

    IDM_HELP_ABOUT          "Displays program information.\nAbout"
END

/* Version information */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "WinNewPad"
            VALUE "FileDescription",  "WinNewPad - An old WordPad-like word processor"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "WinNewPad"
            VALUE "LegalCopyright",   "See LICENSE"
            VALUE "OriginalFilename", "WinNewPad.exe"
            VALUE "ProductName",      "WinNewPad"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
